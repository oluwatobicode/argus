{
  "name": "@argusdev/sdk-vue",
  "version": "0.3.0",
  "description": "Argus SDK for Vue 3 — app-level error handler plugin on top of @argusdev/sdk-browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@argusdev/sdk-browser": "workspace:*",
    "@argusdev/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vue": "^3.5.0"
  },
  "license": "MIT",
  "author": "Treasure Odetokun",
  "homepage": "https://github.com/oluwatobicode/argus#readme",
  "keywords": [
    "argus",
    "error-tracking",
    "monitoring",
    "sdk",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oluwatobicode/argus.git",
    "directory": "packages/sdk-vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
